// Base configuration for the PamukWidgetExtension target (Debug, Release and Profile).
// Brings in FLUTTER_BUILD_NAME / FLUTTER_BUILD_NUMBER from `flutter build`, so the extension's
// CFBundleShortVersionString / CFBundleVersion (see Info.plist) always match the Runner app's.
// Deliberately does NOT include ../Flutter/Debug.xcconfig or Release.xcconfig: those pull in the
// Runner's CocoaPods settings, which must not be linked into the extension.
#include? "../Flutter/Generated.xcconfig"
