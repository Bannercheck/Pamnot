<?xml version="1.0" encoding="utf-8"?>
<!-- Slim rounded progress bar: soft track + lavender-to-mint fill with rounded ends. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/pamnot_widget_track" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale
            android:scaleGravity="start|center_vertical"
            android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:endColor="@color/pamnot_mint"
                    android:startColor="@color/pamnot_lavender" />
                <corners android:radius="999dp" />
            </shape>
        </scale>
    </item>
</layer-list>
