<?xml version="1.0" encoding="utf-8"?>
<!-- Done items are rendered with setEnabled(false) (remotable since API 1), which switches to the
     dimmed colour; resolved by the launcher at inflation time, so it follows light/dark mode. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/pamuk_widget_text_done"/>
    <item android:color="@color/pamuk_widget_text"/>
</selector>
