<?xml version="1.0" encoding="utf-8"?>
<!-- "Pamnot · Today" widget. Default 4x2, resizable down to 2x2 (small layout) and up to 4x4+.
     description / previewLayout / targetCell* are read on Android 12+ and ignored before. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/pamnot_widget_description"
    android:initialLayout="@layout/pamnot_today_widget_medium"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/pamnot_today_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
