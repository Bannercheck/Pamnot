<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview for the widget picker (appwidget-provider previewLayout, Android 12+). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pamnot_widget_bg"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">
    <LinearLayout
        android:id="@+id/pw_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_stat_pamnot"
                android:tint="@color/pamnot_lavender" />

            <TextView
                android:id="@+id/pw_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/pamnot_widget_text"
                android:textSize="16sp"
                android:text="@string/pamnot_widget_preview_title" />

            <TextView
                android:id="@+id/pw_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/pamnot_widget_text_secondary"
                android:textSize="12sp"
                android:text="@string/pamnot_widget_preview_date" />

            <TextView
                android:id="@+id/pw_progress_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/pamnot_widget_pill"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/pamnot_widget_accent_text"
                android:textSize="11sp"
                android:text="@string/pamnot_widget_preview_progress" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/pw_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="9dp"
            android:indeterminate="false"
            android:maxHeight="5dp"
            android:minHeight="5dp"
            android:progressDrawable="@drawable/pamnot_widget_progress"
            android:max="3"
            android:progress="1" />

        <LinearLayout
            android:id="@+id/pw_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/pw_row_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/pw_dot_0"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/pamnot_widget_dot"
                    android:tint="#FF9B8AD8" />

                <TextView
                    android:id="@+id/pw_item_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/pamnot_widget_item_title"
                    android:textSize="13sp"
                    android:text="@string/pamnot_widget_preview_item_1"
                    android:enabled="false" />

                <TextView
                    android:id="@+id/pw_time_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/pamnot_widget_item_time"
                    android:textSize="12sp"
                    android:text="09:30"
                    android:enabled="false" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pw_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/pw_dot_1"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/pamnot_widget_dot_ring"
                    android:tint="#FFF2A88A" />

                <TextView
                    android:id="@+id/pw_item_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/pamnot_widget_item_title"
                    android:textSize="13sp"
                    android:text="@string/pamnot_widget_preview_item_2" />

                <TextView
                    android:id="@+id/pw_time_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/pamnot_widget_item_time"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pw_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/pw_dot_2"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/pamnot_widget_dot_event"
                    android:tint="#FF86C5B0" />

                <TextView
                    android:id="@+id/pw_item_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/pamnot_widget_item_title"
                    android:textSize="13sp"
                    android:text="@string/pamnot_widget_preview_item_3" />

                <TextView
                    android:id="@+id/pw_time_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/pamnot_widget_item_time"
                    android:textSize="12sp"
                    android:text="19:00" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
