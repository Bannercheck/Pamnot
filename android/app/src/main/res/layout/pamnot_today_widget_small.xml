<?xml version="1.0" encoding="utf-8"?>
<!-- Small (2x2) layout of PamnotTodayWidgetProvider. Up to 3 rows; PamnotTodayWidgetProvider shows as many as fit. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pamnot_widget_bg"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">
    <LinearLayout
        android:id="@+id/pw_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pw_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/pamnot_widget_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/pw_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/pamnot_widget_accent_text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pw_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/pamnot_widget_text_secondary"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/pw_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/pw_row_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/pw_dot_0"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/pamnot_widget_dot" />

                <TextView
                    android:id="@+id/pw_item_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/pamnot_widget_item_title"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/pw_time_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/pamnot_widget_item_time"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pw_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/pw_dot_1"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/pamnot_widget_dot" />

                <TextView
                    android:id="@+id/pw_item_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/pamnot_widget_item_title"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/pw_time_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/pamnot_widget_item_time"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pw_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/pw_dot_2"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/pamnot_widget_dot" />

                <TextView
                    android:id="@+id/pw_item_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/pamnot_widget_item_title"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/pw_time_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/pamnot_widget_item_time"
                    android:textSize="11sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/pw_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/pamnot_widget_text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pw_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/pamnot_widget_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/pw_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="6dp"
            android:indeterminate="false"
            android:maxHeight="5dp"
            android:minHeight="5dp"
            android:progressDrawable="@drawable/pamnot_widget_progress"
            android:max="1"
            android:progress="0" />
    </LinearLayout>

    <!-- Shown until the app has written data (and when the data is from a previous day). -->
    <LinearLayout
        android:id="@+id/pw_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_stat_pamnot"
            android:tint="@color/pamnot_lavender" />

        <TextView
            android:id="@+id/pw_placeholder_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/pamnot_widget_placeholder_title"
            android:textColor="@color/pamnot_widget_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pw_placeholder_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:text="@string/pamnot_widget_placeholder_text"
            android:textColor="@color/pamnot_widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
